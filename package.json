{
  "name": "vyvyd",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "studio:server": "node packages/studio-companion/src/server.mjs",
    "studio:mcp": "node packages/studio-companion/src/mcp-server.mjs",
    "studio:setup": "node scripts/setup-studio-mcp.mjs",
    "studio:package": "npm run build --prefix packages/studio-companion",
    "studio:pack": "npm pack ./packages/studio-companion",
    "studio:proof:prepare": "node scripts/prepare-studio-proof.mjs",
    "studio:proof:server": "node scripts/studio-proof-server.mjs",
    "studio:proof:render": "node scripts/prepare-studio-proof.mjs && node scripts/studio-proof-render.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "node --test",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=vyvyd"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@fontsource/noto-sans-kr": "5.3.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@remotion/browser-bundler": "4.0.532",
    "@remotion/bundler": "4.0.532",
    "@remotion/canvas": "4.0.532",
    "@remotion/player": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "@tanstack/react-query": "^5.45.1",
    "@tanstack/react-router": "^1.34.12",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "gifshot": "^0.4.5",
    "gifuct-js": "^2.1.2",
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.532",
    "tailwind-merge": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.6.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.11.0",
    "@typescript-eslint/parser": "^7.11.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.2.2",
    "vite": "^5.2.11",
    "wrangler": "^3.57.1"
  }
}
